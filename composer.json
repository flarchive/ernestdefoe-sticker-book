{
    "name": "ernestdefoe/sticker-book",
    "description": "Sticker Book: members collect stickers in an album. A free pack every day with a flip-and-shine reveal, extra packs for taking part, common to legendary rarities with a pity timer, set badges, race-safe trades of spares, rarest stickers on profiles and sticker reactions on posts.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "stickers",
        "collectibles",
        "album",
        "trading",
        "gamification",
        "engagement"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/sticker-book",
    "support": {
        "issues": "https://github.com/ernestdefoe/sticker-book/issues",
        "source": "https://github.com/ernestdefoe/sticker-book"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\StickerBook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\StickerBook\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Sticker Book",
            "category": "feature",
            "icon": {
                "name": "fas fa-note-sticky",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/likes",
                "fof/badges"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/likes": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
